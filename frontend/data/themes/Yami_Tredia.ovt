/* ------------------------------------------------------------------------- *
 * Tredia Studio, dark. The same design language as tredia.cloud: rounded    *
 * cards floating on the "stage" plum, one purple accent, pink for live.     *
 * Every rule below uses the --tr_* colours, so the light theme              *
 * (Yami_Tredia_Light.ovt) only swaps colours and icons.                     *
 * Built on Yami (OBS Studio's theme).                                       *
 * ------------------------------------------------------------------------- */

@OBSThemeMeta {
    name: 'Tredia (داكن)';
    id: 'com.tredia.Studio';
    extends: 'com.obsproject.Yami';
    author: 'Tredia';
    dark: 'true';
}

@OBSThemeVars {
    /* Tredia's own studio (Tredia Studio for PC), dark: its colours measured from the app itself. */
    --tr_window: #100822;
    --tr_glow_pink: #311335;
    --tr_glow_blue: #261247;
    --tr_bar: #1A1033;
    --tr_preview: #0A0515;
    --tr_card: #1E172F;
    --tr_card_line: #2E2741;
    --tr_divider: #2C2539;
    --tr_raised: #1C1236;
    --tr_raised_line: #352E44;
    --tr_hover: #1C1236;
    --tr_text: #F5F1FF;
    --tr_muted: #A99FC9;
    --tr_faint: #6E6390;
    --tr_accent: #7B4CE0;
    --tr_accent_hover: #8C64EC;
    --tr_accent_ink: #FFFFFF;
    /* The studio's own accent (its "+ مصدر", switches, selected cards): light purple, dark ink. */
    --tr_brand: #B9A0F7;
    --tr_brand_hover: #CBB8FA;
    --tr_brand_ink: #1D1236;
    --tr_link: #B9A0F7;
    --tr_select: #312747;
    --tr_select_line: #6C5B93;
    --tr_live: #EA62AC;
    --tr_live_hover: #F07DBB;
    --tr_live_soft: rgba(234, 98, 172, 0.12);
    --tr_rec: #F0606F;
    --tr_rec_hover: #F37A86;
    --tr_ok: #34C79A;
    --tr_warn_bg: rgba(242, 180, 65, 0.08);
    --tr_warn_line: rgba(242, 180, 65, 0.40);
    --tr_warn_text: #F6CF7E;
    --tr_meter_bg: #2C2539;
    --tr_meter: #B9A0F7;

    /* Yami's own scale, mapped onto them */
    --grey1: #6E6390;
    --grey2: #4D3F6E;
    --grey3: #3A2F57;
    --grey4: #2C2150;
    --grey5: #241A40;
    --grey6: #1C1236;
    --grey7: #140B2A;
    --grey8: #0A0515;

    --purple1: #CBB8FA;
    --purple2: #B9A0F7;
    --purple3: #8C64EC;
    --purple4: #7B4CE0;
    --purple5: #5C33B8;
    --purple6: #2C1D4A;

    --blue1: #B9A0F7;
    --blue2: #8C64EC;
    --blue3: #7B4CE0;
    --blue4: #5C33B8;
    --blue5: #3A2470;
    --blue6: #2C1D4A;

    --pink1: #EA62AC;
    --pink2: #E0479E;
    --pink3: #C42E84;

    --bg_window: var(--tr_window);
    --bg_base: var(--tr_card);
    --bg_preview: var(--tr_preview);

    --primary: var(--tr_accent);
    --primary_light: var(--tr_accent_hover);
    --primary_lighter: var(--tr_link);
    --primary_dark: var(--purple5);
    --primary_darker: var(--purple6);

    --text: var(--tr_text);
    --text_light: var(--tr_text);
    --text_muted: var(--tr_muted);
    --text_disabled: var(--tr_faint);
    --highlight_color: var(--tr_accent_hover);

    /* One step bigger than OBS: Arabic needs the room. */
    --font_base_value: calc(var(--obsFontScale) + 1);

    --border_color: var(--tr_card_line);
    --border_radius: 10px;
    --border_radius_small: 7px;
    --border_radius_large: 22px;

    --input_bg: var(--tr_raised);
    --input_bg_hover: var(--tr_hover);
    --input_bg_focus: var(--tr_raised);
    --input_border: var(--tr_raised_line);
    --input_border_hover: var(--grey1);
    --input_border_focus: var(--tr_accent);

    --list_item_bg_selected: var(--tr_select);
    --list_item_bg_hover: var(--tr_hover);

    --button_bg: var(--tr_raised);
    --button_bg_hover: var(--tr_hover);
    --button_bg_down: var(--tr_card);
    --button_bg_disabled: var(--tr_card);
    --button_border: var(--tr_raised_line);
    --button_border_hover: var(--grey1);
    --button_border_focus: var(--tr_accent);

    --tab_bg: var(--tr_card);
    --tab_bg_hover: var(--tr_hover);
    --tab_bg_down: var(--tr_select);
    --tab_border: var(--tr_raised_line);
    --tab_border_selected: var(--tr_accent);
    --tab_border_focus: var(--tr_accent_hover);

    --scrollbar_size: 8px;
    --scrollbar_handle: var(--tr_raised_line);
    --scrollbar_bg: transparent;
    --scrollbar_hover: var(--grey1);
    --scrollbar_down: var(--tr_accent);
    --scrollbar_border: transparent;

    --separator_hover: var(--tr_accent);

    --palette_highlight: var(--tr_accent);
    --palette_link: var(--tr_link);
    --palette_linkVisited: var(--tr_link);
}

/* ---- Type ------------------------------------------------------------------------------------- */

QWidget {
    font-family: 'IBM Plex Sans Arabic', 'Segoe UI', 'Open Sans', sans-serif;
}

/* ---- The stage and its cards ------------------------------------------------------------------ */

/* The window: the studio's colour with its two soft glows, pink in the top corner and blue in the
 * bottom one, showing in the gaps between the panels. */
QMainWindow {
    background: qlineargradient(x1: 1, y1: 0, x2: 0, y2: 1, stop: 0 var(--tr_glow_pink), stop: 0.36 var(--tr_window), stop: 0.66 var(--tr_window), stop: 1 var(--tr_glow_blue));
}

QStatusBar,
QMenuBar {
    background-color: var(--tr_window);
}

QMainWindow::separator {
    background: transparent;
    width: 12px;
    height: 12px;
    margin: 0px;
}

QMainWindow::separator:hover {
    background: var(--tr_select);
    border: none;
    margin: 3px;
}

QDockWidget {
    font-size: var(--font_base);
    font-weight: 600;
    color: var(--tr_text);
    titlebar-close-icon: url(theme:Tredia/close.svg);
    titlebar-normal-icon: url(theme:Tredia/popout.svg);
}

/* A panel's header: Tredia Studio's own (its name and its "+"), or Qt's title for other panels. */
QWidget#trediaPanelHeader,
QDockWidget::title {
    background-color: var(--tr_card);
    border: 1px solid var(--tr_card_line);
    border-bottom: 1px solid var(--tr_divider);
    border-top-left-radius: var(--border_radius_large);
    border-top-right-radius: var(--border_radius_large);
}

QDockWidget::title {
    padding: 13px 20px 11px 20px;
}

QLabel#trediaPanelTitle {
    background: transparent;
    font-size: var(--font_large);
    font-weight: 600;
    color: var(--tr_text);
}

QToolButton#trediaPanelAdd {
    qproperty-icon: url(theme:Tredia/plus.svg);
    background: transparent;
    border: none;
    border-radius: 16px;
    padding: 8px;
    margin: 0px;
}

QToolButton#trediaPanelAdd:hover {
    background: var(--tr_raised);
}

QPushButton#trediaPanelPrimary {
    qproperty-icon: url(theme:TrediaInk/plus.svg);
    icon-size: 14px;
    background: var(--tr_brand);
    border: 1px solid var(--tr_brand);
    color: var(--tr_brand_ink);
    border-radius: 16px;
    height: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0px 14px;
    margin: 0px;
    font-weight: 600;
}

QPushButton#trediaPanelPrimary:hover {
    background: var(--tr_brand_hover);
    border-color: var(--tr_brand_hover);
}

QDockWidget::close-button,
QDockWidget::float-button {
    border-radius: 7px;
    padding: 3px;
    margin: 5px 3px 0px 3px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background: var(--tr_hover);
}

OBSDock > QWidget {
    background: var(--tr_card);
    border: 1px solid var(--tr_card_line);
    border-top: none;
    border-bottom-left-radius: var(--border_radius_large);
    border-bottom-right-radius: var(--border_radius_large);
}

OBSDock QToolBar {
    border-top: 1px solid var(--tr_card_line);
    padding: 3px 8px;
    height: 38px;
    max-height: 38px;
}

OBSDock QToolBar QToolButton {
    border: 1px solid transparent;
    border-radius: 9px;
}

OBSDock QToolBar QToolButton:hover {
    background: var(--tr_hover);
    border-color: transparent;
}

QAbstractItemView {
    background-color: var(--tr_card);
}

OBSQTDisplay {
    qproperty-displayBackgroundColor: var(--tr_preview);
}

/* ---- Lists: scenes, sources ------------------------------------------------------------------- */

QListView,
QListWidget {
    padding: 8px;
}

/* Only the scenes list gets inner padding: the sources list places a widget in each row, and padding
 * there clips it. Rows are the studio's soft pills. */
QListWidget::item {
    padding: 9px 12px;
}

QListView::item,
QListWidget::item,
SourceTreeItem {
    border-radius: 16px;
}

QListView::item:hover,
QListWidget::item:hover {
    background: var(--tr_hover);
    border: 1px solid transparent;
}

QListView::item:selected,
QListWidget::item:selected {
    background-color: var(--tr_select);
    border: 1px solid var(--tr_select_line);
    color: var(--tr_text);
}

QListView::item:selected:hover,
QListWidget::item:selected:hover {
    background: var(--tr_select);
    border: 1px solid var(--tr_accent_hover);
}

QListView::item:focus,
QListWidget::item:focus,
QListView::item:selected:focus,
QListWidget::item:selected:focus {
    border: 1px solid var(--tr_accent_hover);
}

QListView QLineEdit,
QListWidget QLineEdit {
    border: 1px solid var(--tr_accent);
}

/* ---- Menus and tooltips ----------------------------------------------------------------------- */

QMenuBar {
    padding: 3px 6px;
}

QMenuBar::item {
    padding: 5px 11px;
    margin: 1px;
    border-radius: 8px;
}

QMenuBar::item:selected {
    background: var(--tr_hover);
}

QMenu {
    background-color: var(--tr_card);
    border: 1px solid var(--tr_raised_line);
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    border-radius: 8px;
    padding: 6px 30px 6px 18px;
}

QMenu::item:selected {
    background-color: var(--tr_select);
    border-color: var(--tr_select_line);
    color: var(--tr_text);
}

QMenu::separator {
    background: var(--tr_card_line);
    margin: 5px 10px;
}

QToolTip {
    background-color: var(--tr_raised);
    color: var(--tr_text);
    border: 1px solid var(--tr_raised_line);
    border-radius: 7px;
    padding: 5px 8px;
}

/* ---- Buttons, fields, checks ------------------------------------------------------------------ */

QPushButton {
    border-radius: 13px;
    padding-left: 16px;
    padding-right: 16px;
}

QPushButton:checked {
    background: var(--tr_select);
    border-color: var(--tr_select_line);
}

QPushButton:focus {
    border-color: var(--tr_accent);
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    border-radius: var(--border_radius);
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: var(--tr_accent);
}

QCheckBox::indicator:unchecked,
QCheckBox::indicator:unchecked:hover,
QGroupBox::indicator:unchecked,
QTableView::indicator:unchecked {
    image: url(theme:Tredia/checkbox_unchecked.svg);
}

QCheckBox::indicator:checked,
QCheckBox::indicator:checked:hover,
QGroupBox::indicator:checked,
QTableView::indicator:checked {
    image: url(theme:Tredia/checkbox_checked.svg);
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QRadioButton::indicator:unchecked {
    image: url(theme:Tredia/radio_unchecked.svg);
}

QRadioButton::indicator:checked {
    image: url(theme:Tredia/radio_checked.svg);
}

QScrollBar::handle {
    border-radius: 4px;
}

QProgressBar::chunk {
    background: var(--tr_accent);
    border: none;
    border-radius: 4px;
}

QSlider::handle:horizontal,
QSlider::handle:vertical {
    background-color: var(--tr_text);
}

QSlider::sub-page:horizontal,
QSlider::add-page:vertical {
    background: var(--tr_accent);
}

/* ---- Source context bar under the preview ----------------------------------------------------- */

#contextContainer {
    background-color: var(--tr_card);
    border: 1px solid var(--tr_card_line);
    border-radius: 14px;
    margin-top: 6px;
}

#contextContainer QPushButton {
    border-radius: 10px;
}

/* ---- The top bar: logo, live status, go live, record ------------------------------------------ */

QToolBar#trediaTopBar {
    background: var(--tr_bar);
    border: none;
    border-bottom: 1px solid var(--tr_divider);
    padding: 8px 14px;
    spacing: 6px;
}

QToolBar#trediaTopBar QLabel {
    background: transparent;
}

QLabel#trediaTopName {
    font-size: var(--font_large);
    font-weight: bold;
    color: var(--tr_text);
    padding: 0px 6px;
}

QLabel#trediaStatus {
    background: transparent;
    border: 1px solid var(--tr_raised_line);
    border-radius: 15px;
    padding: 5px 16px;
    color: var(--tr_muted);
    font-weight: 600;
}

QLabel#trediaStatus[state="starting"] {
    color: var(--tr_text);
    border-color: var(--tr_brand);
}

QLabel#trediaStatus[state="live"] {
    background: var(--tr_live);
    border-color: var(--tr_live);
    color: #FFFFFF;
}

QLabel#trediaStatus[state="rec"] {
    background: var(--tr_rec);
    border-color: var(--tr_rec);
    color: #FFFFFF;
}

QToolBar#trediaTopBar QToolButton {
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 7px;
    background: transparent;
}

QToolBar#trediaTopBar QToolButton:hover {
    background: var(--tr_raised);
}

QToolBar#trediaTopBar QToolButton:checked {
    background: var(--tr_select);
    border-color: var(--tr_select_line);
}

QToolButton#trediaMenuButton {
    qproperty-icon: url(theme:Tredia/menu.svg);
}

/* The vertical picture in the top bar: horizontal / both / vertical, and its switch. */
QWidget#trediaSegment {
    background: var(--tr_raised);
    border: 1px solid var(--tr_raised_line);
    border-radius: 18px;
}

QToolBar#trediaTopBar QToolButton#trediaSegmentButton {
    background: transparent;
    border: none;
    border-radius: 14px;
    padding: 4px 12px;
    color: var(--tr_muted);
    font-weight: 500;
}

QToolBar#trediaTopBar QToolButton#trediaSegmentButton:hover {
    background: transparent;
    color: var(--tr_text);
}

QToolBar#trediaTopBar QToolButton#trediaSegmentButton:checked {
    background: var(--tr_brand);
    color: var(--tr_brand_ink);
    border: none;
}

QToolBar#trediaTopBar QCheckBox#trediaSwitch {
    background: transparent;
    color: var(--tr_muted);
    spacing: 8px;
    padding: 0px 6px;
}

/* The vertical picture's preview, beside OBS's own. */
TrediaVerticalPreview {
    qproperty-displayBackgroundColor: var(--tr_preview);
}

QLabel#trediaPreviewCaption {
    background: transparent;
    color: var(--tr_muted);
    font-weight: 500;
    padding: 6px 2px 0px 2px;
}

QToolButton#trediaMenuButton::menu-indicator {
    image: none;
    width: 0px;
}

QToolButton#trediaThemeButton {
    qproperty-icon: url(theme:Tredia/sun.svg);
}

QToolButton#trediaStudioButton {
    qproperty-icon: url(theme:Tredia/studio.svg);
}

QToolButton#trediaSettingsButton {
    qproperty-icon: url(theme:Tredia/gear.svg);
}

/* Record and go live: the studio's pill buttons, with the red dot and the white live dot (a stop
 * square while running). */
QPushButton#trediaGoLive,
QPushButton#trediaRecord {
    height: 40px;
    min-height: 40px;
    max-height: 40px;
    border-radius: 20px;
    padding: 0px 20px;
    margin: 0px;
    font-weight: 600;
    icon-size: 12px;
}

QPushButton#trediaGoLive {
    qproperty-icon: url(theme:Tredia/live-dot.svg);
    background: var(--tr_live);
    border: 1px solid var(--tr_live);
    color: #FFFFFF;
}

QPushButton#trediaGoLive:hover {
    background: var(--tr_live_hover);
    border-color: var(--tr_live_hover);
}

QPushButton#trediaGoLive[live="true"] {
    qproperty-icon: url(theme:TrediaInk/stop.svg);
    background: var(--tr_brand);
    border-color: var(--tr_brand);
    color: var(--tr_brand_ink);
}

QPushButton#trediaGoLive:disabled {
    background: var(--tr_raised);
    border-color: var(--tr_raised_line);
    color: var(--tr_muted);
}

QPushButton#trediaRecord {
    qproperty-icon: url(theme:Tredia/rec.svg);
    background: var(--tr_raised);
    border: 1px solid var(--tr_raised_line);
    color: var(--tr_text);
}

QPushButton#trediaRecord:hover {
    border-color: var(--tr_select_line);
}

QPushButton#trediaRecord[on="true"] {
    qproperty-icon: url(theme:Tredia/stop.svg);
    background: var(--tr_rec);
    border-color: var(--tr_rec);
    color: #FFFFFF;
}

/* OBS's own controls dock, for people who turn it back on */
#streamButton,
#recordButton,
#broadcastButton {
    border-radius: 13px;
    font-weight: bold;
}

#streamButton:!checked,
#broadcastButton:!checked {
    background: var(--tr_live);
    border: 1px solid var(--tr_live);
    color: #FFFFFF;
}

#streamButton:!hover:!pressed.state-active,
#broadcastButton:!hover:!pressed.state-active {
    background: var(--tr_text);
    border-color: var(--tr_text);
    color: var(--tr_card);
}

#recordButton:!hover:!pressed.state-active {
    background: var(--tr_rec);
    border-color: var(--tr_rec);
    color: #FFFFFF;
}

/* ---- Audio mixer ------------------------------------------------------------------------------ */

/* The studio's meter: one quiet track, purple rising to amber and pink when it's loud. */
VolumeMeter {
    qproperty-backgroundNominalColor: var(--tr_meter_bg);
    qproperty-backgroundWarningColor: var(--tr_meter_bg);
    qproperty-backgroundErrorColor: var(--tr_meter_bg);
    qproperty-foregroundNominalColor: var(--tr_meter);
    qproperty-foregroundWarningColor: #F2B441;
    qproperty-foregroundErrorColor: var(--tr_live);
    qproperty-majorTickColor: var(--tr_muted);
    qproperty-minorTickColor: var(--tr_faint);
}

/* ---- Status bar ------------------------------------------------------------------------------- */

QStatusBar {
    color: var(--tr_muted);
}

/* ---- Icons: Tredia's own set ------------------------------------------------------------------ */

.icon-plus { qproperty-icon: url(theme:Tredia/plus.svg); }
.icon-minus { qproperty-icon: url(theme:Tredia/minus.svg); }
.icon-trash { qproperty-icon: url(theme:Tredia/trash.svg); }
.icon-gear { qproperty-icon: url(theme:Tredia/gear.svg); }
.icon-dots-vert { qproperty-icon: url(theme:Tredia/dots-vert.svg); }
.icon-refresh { qproperty-icon: url(theme:Tredia/refresh.svg); }
.icon-up { qproperty-icon: url(theme:Tredia/up.svg); }
.icon-down { qproperty-icon: url(theme:Tredia/down.svg); }
.icon-filter { qproperty-icon: url(theme:Tredia/filter.svg); }
.icon-close { qproperty-icon: url(theme:Tredia/close.svg); }

QPushButton#sourcePropertiesButton { qproperty-icon: url(theme:Tredia/gear.svg); }
QPushButton#sourceFiltersButton { qproperty-icon: url(theme:Tredia/filter.svg); }
QToolBarExtension { qproperty-icon: url(theme:Tredia/dots-vert.svg); }

.btn-mute { qproperty-icon: url(theme:Tredia/audio.svg); }
.btn-mute.checked { qproperty-icon: url(theme:Tredia/mute.svg); }
.btn-monitor { qproperty-icon: url(theme:Tredia/headphones-off.svg); }
.btn-monitor.checked { qproperty-icon: url(theme:Tredia/headphones.svg); }

.indicator-lock::indicator:checked,
.indicator-lock::indicator:checked:hover {
    image: url(theme:Tredia/locked.svg);
}

.indicator-lock::indicator:unchecked,
.indicator-lock::indicator:unchecked:hover {
    image: url(theme:Tredia/unlocked.svg);
}

.indicator-visibility::indicator:checked,
.indicator-visibility::indicator:checked:hover {
    image: url(theme:Tredia/visible.svg);
}

.indicator-visibility::indicator:unchecked,
.indicator-visibility::indicator:unchecked:hover {
    image: url(theme:Tredia/invisible.svg);
}

OBSBasic {
    qproperty-imageIcon: url(theme:Tredia/image.svg);
    qproperty-colorIcon: url(theme:Tredia/brush.svg);
    qproperty-slideshowIcon: url(theme:Tredia/slideshow.svg);
    qproperty-audioInputIcon: url(theme:Tredia/microphone.svg);
    qproperty-audioOutputIcon: url(theme:Tredia/audio.svg);
    qproperty-desktopCapIcon: url(theme:Tredia/monitor.svg);
    qproperty-windowCapIcon: url(theme:Tredia/window.svg);
    qproperty-gameCapIcon: url(theme:Tredia/gamepad.svg);
    qproperty-cameraIcon: url(theme:Tredia/camera.svg);
    qproperty-textIcon: url(theme:Tredia/text.svg);
    qproperty-mediaIcon: url(theme:Tredia/media.svg);
    qproperty-browserIcon: url(theme:Tredia/globe.svg);
    qproperty-groupIcon: url(theme:Tredia/folder.svg);
    qproperty-sceneIcon: url(theme:Tredia/layers.svg);
    qproperty-defaultIcon: url(theme:Tredia/box.svg);
    qproperty-audioProcessOutputIcon: url(theme:Tredia/app-audio.svg);
}

/* ---- The Tredia panel ------------------------------------------------------------------------- */

#trediaDock QScrollArea,
#trediaDock QScrollArea > QWidget,
#trediaDock QStackedWidget,
#trediaDock QStackedWidget > QWidget {
    background: transparent;
}

#trediaDock QCheckBox,
#trediaDock QRadioButton {
    background: transparent;
    margin-top: 0px;
}

#trediaDock QLabel#trediaTitle {
    font-size: var(--font_xlarge);
    font-weight: bold;
}

#trediaDock QLabel#trediaName {
    font-size: var(--font_large);
    font-weight: bold;
}

#trediaDock QLabel#trediaHeading {
    font-weight: bold;
    color: var(--tr_text);
    padding-top: 4px;
}

#trediaDock QLabel#trediaMuted {
    color: var(--tr_muted);
}

#trediaDock QLabel#trediaRowTitle,
#trediaDock QRadioButton#trediaOptionTitle {
    font-weight: bold;
}

#trediaDock QLabel#trediaError {
    color: var(--tr_rec);
}

#trediaDock QLabel#trediaOk {
    color: var(--tr_ok);
}

#trediaDock QLabel#trediaField {
    font-weight: 500;
    color: var(--tr_text);
    padding-top: 2px;
}

#trediaDock QLabel#trediaAvatar {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1, stop: 0 var(--tr_brand), stop: 1 var(--tr_live));
    color: #FFFFFF;
    border-radius: 20px;
    font-weight: bold;
}

#trediaDock QFrame#trediaCard,
#trediaDock QFrame#trediaHeader,
#trediaDock QFrame#trediaOption,
#trediaDock QFrame#trediaRow {
    background: var(--tr_raised);
    border: 1px solid var(--tr_raised_line);
    border-radius: 18px;
}

#trediaDock QFrame#trediaOption[selected="true"] {
    background: var(--tr_select);
    border: 1px solid var(--tr_brand);
}

/* Fields: the studio's soft, rounded inputs. */
#trediaDock QLineEdit,
#trediaDock QPlainTextEdit {
    background: var(--tr_raised);
    border: 1px solid var(--tr_raised_line);
    border-radius: 14px;
}

#trediaDock QLineEdit {
    min-height: 38px;
    padding: 0px 12px;
}

#trediaDock QPlainTextEdit {
    padding: 6px 8px;
}

#trediaDock QLineEdit:focus,
#trediaDock QPlainTextEdit:focus {
    border-color: var(--tr_brand);
}

/* A platform's on/off: a switch, as in the studio. */
QCheckBox#trediaSwitch::indicator {
    width: 44px;
    height: 24px;
}

QCheckBox#trediaSwitch::indicator:unchecked,
QCheckBox#trediaSwitch::indicator:unchecked:hover {
    image: url(theme:Tredia/switch_off.svg);
}

QCheckBox#trediaSwitch::indicator:checked,
QCheckBox#trediaSwitch::indicator:checked:hover {
    image: url(theme:Tredia/switch_on.svg);
}

#trediaDock QLabel#trediaWarning {
    background: var(--tr_warn_bg);
    border: 1px solid var(--tr_warn_line);
    border-radius: 11px;
    padding: 8px 10px;
    color: var(--tr_warn_text);
}

#trediaDock QLabel#trediaLive {
    background: var(--tr_live_soft);
    border: 1px solid var(--tr_live);
    border-radius: 11px;
    padding: 8px 10px;
}

#trediaDock QLabel#trediaUpdate {
    background: var(--tr_select);
    border: 1px solid var(--tr_select_line);
    border-radius: 11px;
    padding: 8px 10px;
}

#trediaDock QLabel#trediaCode {
    font-size: 24pt;
    font-weight: bold;
    padding: 6px;
}

/* Buttons: the studio's pills (40 px), the main one in its accent, quiet text buttons for links. */
#trediaDock QPushButton {
    border-radius: 19px;
    min-height: 38px;
    font-weight: 600;
}

#trediaDock QPushButton#trediaPrimary {
    background: var(--tr_brand);
    border: 1px solid var(--tr_brand);
    color: var(--tr_brand_ink);
}

#trediaDock QPushButton#trediaPrimary:hover {
    background: var(--tr_brand_hover);
    border-color: var(--tr_brand_hover);
}

#trediaDock QPushButton#trediaPrimary:disabled {
    background: var(--tr_raised);
    border-color: var(--tr_raised_line);
    color: var(--tr_faint);
}

#trediaDock QPushButton:flat {
    background: transparent;
    border: 1px solid transparent;
    color: var(--tr_muted);
    min-height: 30px;
    border-radius: 15px;
    padding-left: 12px;
    padding-right: 12px;
}

#trediaDock QPushButton:flat:hover {
    background: var(--tr_raised);
    color: var(--tr_text);
}

/* A platform's picture: horizontal or vertical (pink, as in the studio). */
#trediaDock QPushButton#trediaOrientation {
    min-height: 24px;
    max-height: 24px;
    border-radius: 12px;
    padding: 0px 10px;
    font-weight: 500;
    background: transparent;
    border: 1px solid var(--tr_raised_line);
    color: var(--tr_text);
}

#trediaDock QPushButton#trediaOrientation:hover {
    border-color: var(--tr_brand);
}

#trediaDock QPushButton#trediaOrientation[vertical="true"] {
    background: var(--tr_live_soft);
    border-color: var(--tr_live);
    color: var(--tr_live);
}

/* ------------------------------------------------------------------------- *
 * Tredia Studio: the default look.                                          *
 * Tredia's plum, darkened for a studio: panels are rounded cards floating   *
 * on a near-black stage, purple is the one accent, pink means "you're live".*
 * Built on Yami (OBS Studio's theme).                                       *
 * ------------------------------------------------------------------------- */

@OBSThemeMeta {
    name: 'Tredia';
    id: 'com.tredia.Studio';
    extends: 'com.obsproject.Yami';
    author: 'Tredia';
    dark: 'true';
}

@OBSThemeVars {
    /* Plum scale, darkest last. Yami's rules use these directly. */
    --grey1: #66568A;
    --grey2: #4D3F69;
    --grey3: #3A2E53;
    --grey4: #2B2140;
    --grey5: #211833;
    --grey6: #171026;
    --grey7: #100B1B;
    --grey8: #0A0712;

    /* Tredia purple */
    --purple1: #CBB8FA;
    --purple2: #A78BF2;
    --purple3: #8C64EC;
    --purple4: #7B4CE0;
    --purple5: #5C33B8;
    --purple6: #2C1D4A;

    /* Live pink and recording red */
    --pink1: #F57DBE;
    --pink2: #E8459B;
    --pink3: #C42E80;
    --rec1: #F0767A;
    --rec2: #E5484D;

    --bg_window: var(--grey8);
    --bg_base: var(--grey6);
    --bg_preview: var(--grey8);

    --primary: var(--purple4);
    --primary_light: var(--purple3);
    --primary_lighter: var(--purple2);
    --primary_dark: var(--purple5);
    --primary_darker: var(--purple6);

    --text: #F4EFFC;
    --text_light: #FFFFFF;
    --text_muted: #A597BF;
    --text_disabled: #6E6288;
    --highlight_color: var(--purple3);

    /* One step bigger than OBS: Arabic needs the room. */
    --font_base_value: calc(var(--obsFontScale) + 1);

    --border_color: #251B37;
    --border_radius: 8px;
    --border_radius_small: 6px;
    --border_radius_large: 14px;

    --input_bg: var(--grey5);
    --input_bg_hover: var(--grey4);
    --input_bg_focus: var(--grey7);
    --input_border: var(--grey3);
    --input_border_hover: var(--grey1);
    --input_border_focus: var(--purple3);

    --list_item_bg_selected: var(--purple6);
    --list_item_bg_hover: var(--grey4);

    --button_bg: var(--grey5);
    --button_bg_hover: var(--grey4);
    --button_bg_down: var(--grey7);
    --button_bg_disabled: var(--grey6);
    --button_border: var(--grey3);
    --button_border_hover: var(--grey1);
    --button_border_focus: var(--purple3);

    --tab_bg: var(--grey6);
    --tab_bg_hover: var(--grey4);
    --tab_bg_down: var(--purple6);
    --tab_border: var(--grey3);
    --tab_border_selected: var(--purple4);
    --tab_border_focus: var(--purple3);

    --scrollbar_size: 8px;
    --scrollbar_handle: var(--grey3);
    --scrollbar_bg: transparent;
    --scrollbar_hover: var(--grey1);
    --scrollbar_down: var(--purple4);
    --scrollbar_border: transparent;

    --separator_hover: var(--purple5);

    --palette_highlight: var(--purple4);
    --palette_link: var(--purple2);
    --palette_linkVisited: var(--purple2);
}

/* ---- Type ------------------------------------------------------------------------------------- */

QWidget {
    font-family: 'IBM Plex Sans Arabic', 'Segoe UI', 'Open Sans', sans-serif;
}

/* ---- The stage and its cards ------------------------------------------------------------------ */

QMainWindow,
QStatusBar,
QMenuBar {
    background-color: var(--bg_window);
}

QMainWindow::separator {
    background: transparent;
    width: 10px;
    height: 10px;
    margin: 0px;
}

QMainWindow::separator:hover {
    background: var(--purple6);
    border: none;
    margin: 3px;
}

QDockWidget {
    font-size: var(--font_base);
    font-weight: 600;
    color: var(--text);
}

QDockWidget::title {
    background-color: var(--bg_base);
    border: 1px solid var(--border_color);
    border-bottom: none;
    border-top-left-radius: var(--border_radius_large);
    border-top-right-radius: var(--border_radius_large);
    padding: 9px 14px 5px 14px;
}

QDockWidget::close-button,
QDockWidget::float-button {
    border-radius: 6px;
    padding: 3px;
    margin: 4px 2px 0px 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background: var(--grey4);
}

OBSDock > QWidget {
    background: var(--bg_base);
    border: 1px solid var(--border_color);
    border-top: none;
    border-bottom-left-radius: var(--border_radius_large);
    border-bottom-right-radius: var(--border_radius_large);
}

OBSDock QToolBar {
    border-top: 1px solid var(--border_color);
    padding: 3px 6px;
    height: 36px;
    max-height: 36px;
}

OBSDock QToolBar QToolButton {
    border: 1px solid transparent;
    border-radius: 8px;
}

OBSDock QToolBar QToolButton:hover {
    background: var(--grey4);
    border-color: transparent;
}

QAbstractItemView {
    background-color: var(--bg_base);
}

/* The preview blends into the stage */
OBSQTDisplay {
    qproperty-displayBackgroundColor: var(--bg_window);
}

/* ---- Lists: scenes, sources ------------------------------------------------------------------- */

QListView,
QListWidget {
    padding: 6px;
}

/* Only the scenes list gets inner padding: the sources list places a widget in each row, and padding there clips it. */
QListWidget::item {
    padding: 6px 10px;
}

QListView::item,
QListWidget::item {
    border-radius: 9px;
}

/* Source rows keep OBS's padding: their height is fixed, and more padding clips Arabic letters. */
SourceTreeItem {
    border-radius: 9px;
}

QListView::item:hover,
QListWidget::item:hover {
    background: var(--grey5);
    border: 1px solid transparent;
}

QListView::item:selected,
QListWidget::item:selected {
    background-color: var(--purple6);
    border: 1px solid var(--purple4);
}

QListView::item:selected:hover,
QListWidget::item:selected:hover {
    background: #36245C;
    border: 1px solid var(--purple3);
}

QListView::item:focus,
QListWidget::item:focus,
QListView::item:selected:focus,
QListWidget::item:selected:focus {
    border: 1px solid var(--purple3);
}

/* ---- Menus and tooltips ----------------------------------------------------------------------- */

QMenuBar {
    padding: 3px 6px;
}

QMenuBar::item {
    padding: 5px 11px;
    margin: 1px;
    border-radius: 8px;
}

QMenuBar::item:selected {
    background: var(--grey4);
}

QMenu {
    background-color: var(--grey6);
    border: 1px solid var(--grey3);
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    border-radius: 8px;
    padding: 6px 30px 6px 18px;
}

QMenu::item:selected {
    background-color: var(--purple6);
    border-color: var(--purple4);
}

QMenu::separator {
    background: var(--grey4);
    margin: 5px 10px;
}

QToolTip {
    background-color: var(--grey4);
    color: var(--text);
    border: 1px solid var(--grey3);
    border-radius: 6px;
    padding: 5px 8px;
}

/* ---- Buttons and fields ----------------------------------------------------------------------- */

QPushButton {
    border-radius: 10px;
    padding-left: 14px;
    padding-right: 14px;
}

QPushButton:checked {
    background: var(--purple6);
    border-color: var(--purple4);
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    border-radius: var(--border_radius);
}

QScrollBar::handle {
    border-radius: 4px;
}

QProgressBar::chunk {
    background: var(--purple4);
    border-top: 1px solid var(--purple3);
    border-bottom: 2px solid var(--purple5);
}

/* ---- Source context bar under the preview ----------------------------------------------------- */

#contextContainer {
    background-color: var(--bg_base);
    border: 1px solid var(--border_color);
    border-radius: 12px;
    margin-top: 6px;
}

#contextContainer QPushButton {
    border-radius: 9px;
}

/* ---- Controls: go live, record ---------------------------------------------------------------- */

#controlsFrame {
    padding: 8px 10px;
}

#controlsFrame QPushButton {
    margin: 3px 2px;
    font-weight: 600;
}

#streamButton,
#recordButton,
#broadcastButton {
    border-radius: 11px;
    font-weight: bold;
}

#streamButton:!checked,
#broadcastButton:!checked {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #7B4CE0, stop: 1 #A04CD6);
    border: 1px solid #8C64EC;
    color: #FFFFFF;
}

#streamButton:hover:!checked,
#broadcastButton:hover:!checked {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #8C64EC, stop: 1 #B05AE2);
}

#streamButton:!hover:!pressed.state-active,
#broadcastButton:!hover:!pressed.state-active {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #E8459B, stop: 1 #F0609F);
    border-color: var(--pink2);
    color: #FFFFFF;
}

#streamButton:hover:!pressed.state-active,
#broadcastButton:hover:!pressed.state-active {
    background: var(--pink1);
    border-color: var(--pink1);
    color: #FFFFFF;
}

#recordButton:!hover:!pressed.state-active {
    background: var(--rec2);
    border-color: var(--rec2);
    color: #FFFFFF;
}

#recordButton:hover:!pressed.state-active {
    background: var(--rec1);
    border-color: var(--rec1);
}

/* ---- Audio mixer ------------------------------------------------------------------------------ */

VolumeMeter {
    qproperty-backgroundNominalColor: #2C1D4A;
    qproperty-backgroundWarningColor: #4A3A16;
    qproperty-backgroundErrorColor: #4D1733;
    qproperty-foregroundNominalColor: #8C64EC;
    qproperty-foregroundWarningColor: #F2B441;
    qproperty-foregroundErrorColor: #E8459B;
    qproperty-majorTickColor: var(--text_muted);
    qproperty-minorTickColor: var(--grey2);
}

QSlider::sub-page:horizontal,
QSlider::add-page:vertical {
    background: var(--purple4);
}

/* ---- Status bar ------------------------------------------------------------------------------- */

QStatusBar {
    color: var(--text_muted);
}

/* ---- The Tredia panel ------------------------------------------------------------------------- */

#trediaDock QScrollArea,
#trediaDock QScrollArea > QWidget,
#trediaDock QStackedWidget,
#trediaDock QStackedWidget > QWidget {
    background: transparent;
}

#trediaDock QCheckBox,
#trediaDock QRadioButton {
    background: transparent;
    margin-top: 0px;
}

#trediaDock QLabel#trediaTitle {
    font-size: var(--font_xlarge);
    font-weight: bold;
}

#trediaDock QLabel#trediaName {
    font-size: var(--font_large);
    font-weight: bold;
}

#trediaDock QLabel#trediaHeading {
    font-weight: bold;
    color: var(--text);
    padding-top: 4px;
}

#trediaDock QLabel#trediaMuted {
    color: var(--text_muted);
}

#trediaDock QLabel#trediaRowTitle,
#trediaDock QRadioButton#trediaOptionTitle {
    font-weight: bold;
}

#trediaDock QLabel#trediaError {
    color: var(--rec1);
}

#trediaDock QLabel#trediaAvatar {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1, stop: 0 #7B4CE0, stop: 1 #E8459B);
    color: #FFFFFF;
    border-radius: 20px;
    font-weight: bold;
}

#trediaDock QFrame#trediaCard,
#trediaDock QFrame#trediaHeader,
#trediaDock QFrame#trediaOption,
#trediaDock QFrame#trediaRow {
    background: var(--grey5);
    border: 1px solid var(--grey3);
    border-radius: 12px;
}

#trediaDock QFrame#trediaOption[selected="true"] {
    background: var(--purple6);
    border: 1px solid var(--purple4);
}

#trediaDock QLabel#trediaWarning {
    background: rgba(242, 180, 65, 0.08);
    border: 1px solid rgba(242, 180, 65, 0.40);
    border-radius: 10px;
    padding: 8px 10px;
    color: #F6CF7E;
}

#trediaDock QLabel#trediaLive {
    background: rgba(232, 69, 155, 0.12);
    border: 1px solid var(--pink3);
    border-radius: 10px;
    padding: 8px 10px;
}

#trediaDock QLabel#trediaUpdate {
    background: var(--purple6);
    border: 1px solid var(--purple5);
    border-radius: 10px;
    padding: 8px 10px;
}

#trediaDock QLabel#trediaCode {
    font-size: 24pt;
    font-weight: bold;
    padding: 6px;
}

#trediaDock QPushButton {
    border-radius: 10px;
}

#trediaDock QPushButton#trediaPrimary {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #7B4CE0, stop: 1 #A04CD6);
    border: 1px solid #8C64EC;
    color: #FFFFFF;
    font-weight: bold;
}

#trediaDock QPushButton#trediaPrimary:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #8C64EC, stop: 1 #B05AE2);
}

#trediaDock QPushButton:flat {
    background: transparent;
    border: 1px solid transparent;
    color: var(--purple2);
    padding-left: 4px;
    padding-right: 4px;
}

#trediaDock QPushButton:flat:hover {
    background: var(--grey4);
}

#trediaBrand {
    background: transparent;
}
